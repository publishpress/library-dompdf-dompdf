{
    "name": "publishpress/dompdf-dompdf",
    "version": "3.1.6.1",
    "type": "library",
    "description": "Dompdf and its runtime dependencies, prefixed for PublishPress",
    "keywords": [
        "pdf",
        "dompdf",
        "publishpress"
    ],
    "homepage": "https://github.com/dompdf/dompdf",
    "license": "LGPL-2.1-or-later",
    "authors": [
        {
            "name": "The Dompdf Community",
            "homepage": "https://github.com/dompdf/dompdf/blob/master/AUTHORS.md"
        },
        {
            "name": "PublishPress",
            "email": "help@publishpress.com"
        }
    ],
    "autoload": {
        "files": [
            "lib/include.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Helper\\": "tests/_support/Helper/"
        }
    },
    "require": {
        "php": ">=7.4.0",
        "ext-dom": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "dompdf/dompdf": "3.1.6",
        "brianhenryie/strauss": "0.29.2",
        "publishpress/version-loader-generator": "^1.0",
        "publishpress/dev-workspace": "^1.8"
    },
    "extra": {
        "plugin-name": "library-dompdf-dompdf",
        "plugin-slug": "library-dompdf-dompdf",
        "plugin-folder": "library-dompdf-dompdf",
        "plugin-lang-domain": "dompdf-dompdf",
        "plugin-github-repo": "publishpress/library-dompdf-dompdf",
        "plugin-composer-package": "publishpress/dompdf-dompdf",
        "generator": {
            "lib-class-test": "class_exists('PublishPress\\Dompdf\\Dompdf', false)",
            "action-register-priority": "-200",
            "action-initialize-priority": "-185"
        },
        "strauss": {
            "target_directory": "lib",
            "namespace_prefix": "PublishPress\\",
            "classmap_prefix": "PublishPress_",
            "constant_prefix": "PUBLISHPRESS_",
            "include_author": true,
            "classmap_output": true,
            "packages": [
                "dompdf/dompdf",
                "dompdf/php-font-lib",
                "dompdf/php-svg-lib",
                "masterminds/html5",
                "sabberworm/php-css-parser"
            ],
            "delete_vendor_packages": true,
            "delete_vendor_files": true
        }
    },
    "scripts": {
        "strauss": [
            "vendor/bin/strauss"
        ],
        "generate-files": [
            "vendor/bin/version-loader-generator",
            "php tests/bin/guard-generated-include.php",
            "php tests/bin/patch-version-loader-cest.php"
        ],
        "post-install-cmd": [
            "@strauss",
            "@generate-files"
        ],
        "post-update-cmd": [
            "@strauss",
            "@generate-files"
        ],
        "test:unit": "vendor/bin/codecept run Unit",
        "test:integration": [
            "bash tests/bin/fix-linux-test-volume-perms.sh",
            "vendor/bin/codecept run Integration"
        ],
        "test:all": [
            "@test:unit",
            "@test:integration"
        ]
    },
    "config": {
        "allow-plugins": {
            "publishpress/dev-workspace": true,
            "composer/installers": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
